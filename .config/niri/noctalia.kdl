layout {

    focus-ring {
        active-color   "#bec8d0"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bec8d0"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#bec8d0"
        inactive-color "#3e484f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bec8d080"
    }
}

recent-windows {
    highlight {
        active-color "#bec8d0"
        urgent-color "#ffb4ab"
    }
}
