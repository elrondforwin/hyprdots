layout {

    focus-ring {
        active-color   "#ffb952"
        inactive-color "#17130e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb952"
        inactive-color "#17130e"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb952"
        inactive-color "#633f00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb95280"
    }
}

recent-windows {
    highlight {
        active-color "#ffb952"
        urgent-color "#ffb4ab"
    }
}
